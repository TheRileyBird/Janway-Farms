    </main>
    <script>
      const flightTrail = document.querySelector('.bee-flight-trail');
      const flightPath = document.querySelector('#bee-flight-path');
      const flightBee = document.querySelector('.bee-flight-cursor');
      const points = [];
      const maxPoints = 18;
      let rafId = 0;
      let hideTimer = 0;
      let targetX = 0;
      let targetY = 0;
      let beeX = 0;
      let beeY = 0;
      let previousBeeX = 0;
      let previousBeeY = 0;
      let hasBeePosition = false;
      let lastPointTime = 0;

      function syncTrailViewBox() {
        flightTrail?.setAttribute('viewBox', `0 0 ${window.innerWidth || 1} ${window.innerHeight || 1}`);
      }

      function buildPath() {
        if (!flightPath || points.length < 2) return;

        let path = `M ${points[0].x.toFixed(1)} ${points[0].y.toFixed(1)}`;

        for (let i = 1; i < points.length - 1; i += 1) {
          const current = points[i];
          const next = points[i + 1];
          const midX = (current.x + next.x) / 2;
          const midY = (current.y + next.y) / 2;
          path += ` Q ${current.x.toFixed(1)} ${current.y.toFixed(1)} ${midX.toFixed(1)} ${midY.toFixed(1)}`;
        }

        const last = points[points.length - 1];
        path += ` T ${last.x.toFixed(1)} ${last.y.toFixed(1)}`;
        flightPath.setAttribute('d', path);
      }

      function queueRender() {
        if (rafId) return;
        rafId = window.requestAnimationFrame(() => {
          const now = performance.now();
          const ease = 0.22;

          previousBeeX = beeX;
          previousBeeY = beeY;
          beeX += (targetX - beeX) * ease;
          beeY += (targetY - beeY) * ease;

          const dx = beeX - previousBeeX;
          const dy = beeY - previousBeeY;
          const angle = Math.atan2(dy, dx) * (180 / Math.PI);

          if (flightBee) {
            flightBee.style.transform = `translate3d(${(beeX - 21).toFixed(1)}px, ${(beeY - 16).toFixed(1)}px, 0) rotate(${angle.toFixed(1)}deg)`;
          }

          if (now - lastPointTime > 34) {
            points.push({ x: beeX, y: beeY });
            if (points.length > maxPoints) points.shift();
            lastPointTime = now;
          }

          buildPath();
          rafId = 0;

          if (flightTrail?.classList.contains('is-active')) {
            queueRender();
          }
        });
      }

      window.addEventListener(
        'pointermove',
        (event) => {
          if (event.pointerType === 'touch') return;

          targetX = event.clientX;
          targetY = event.clientY;

          if (!hasBeePosition) {
            beeX = targetX;
            beeY = targetY;
            previousBeeX = beeX - 1;
            previousBeeY = beeY;
            points.push({ x: beeX, y: beeY });
            hasBeePosition = true;
          }

          flightTrail?.classList.add('is-active');
          flightBee?.classList.add('is-active');
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(() => {
            flightTrail?.classList.remove('is-active');
            flightBee?.classList.remove('is-active');
            points.length = 0;
            hasBeePosition = false;
            flightPath?.setAttribute('d', '');
          }, 1800);

          queueRender();
        },
        { passive: true },
      );

      syncTrailViewBox();
      window.addEventListener('resize', syncTrailViewBox, { passive: true });
    </script>
  </body>
</html>
