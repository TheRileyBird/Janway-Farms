          <div class="md:pl-4 lg:pl-12">
            <p class="font-eyebrow text-2xl text-honey-700">Contact</p>
            <div class="mt-6 space-y-4 text-sm font-semibold leading-6 text-honey-100/70">
              <p class="flex items-start gap-3"><MapPin class="mt-0.5 h-4 w-4 shrink-0 text-honey-300" /> 13738 Mary Edith Pl, Baton Rouge, LA 70809-5507</p>
